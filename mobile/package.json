{
  "name": "trucker-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.25",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "ios": "expo start --ios --port 8082",
    "prebuild:ios": "expo prebuild -p ios --clean",
    "ios:release": "expo run:ios --device --configuration Release",
    "deploy:ios": "scripts/deploy-ios.sh",
    "android": "expo start --android --port 8082",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/Warsaw LC_ALL=en_GB.UTF-8 jest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest.style-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  }
}
